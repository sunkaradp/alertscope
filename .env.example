# copy to .env, used by `make up`
ALERTSCOPE_LLM_PROVIDER=stub

# GitHub Pages browser console: exact allowed origins, JSON array.
# For a custom Pages domain, replace this with that exact HTTPS origin.
ALERTSCOPE_CORS_ORIGINS=["https://sunkaradp.github.io"]

# Bedrock (uses ~/.aws credentials locally)
# ALERTSCOPE_LLM_PROVIDER=bedrock
# AWS_PROFILE=default
# ALERTSCOPE_BEDROCK_REGION=eu-central-1
# ALERTSCOPE_BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Vertex AI (run `gcloud auth application-default login` first)
# ALERTSCOPE_LLM_PROVIDER=vertex
# ALERTSCOPE_VERTEX_PROJECT=my-project-123
# GOOGLE_APPLICATION_CREDENTIALS=/home/app/.config/gcloud/application_default_credentials.json

# ALERTSCOPE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional: protect the Alertmanager webhook and incident API with a shared bearer token.
# ALERTSCOPE_WEBHOOK_TOKEN=replace-with-a-long-random-secret
ALERTSCOPE_MAX_PENDING_TASKS=100

# Local Grafana login (change this before exposing Grafana beyond localhost).
GRAFANA_ADMIN_PASSWORD=local-alertscope-password
